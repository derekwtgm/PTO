+}
+mcs = subprocess.run(['mcs', '--version'], capture_output=True, text=True).stdout.strip()
+out = {'format': 'eightmax-build-check', 'version': 1, 'milestone': '0.36.2-milestone-2', 'at': datetime.datetime.now(datetime.timezone.utc).isoformat(), 'buildHost': 'Linux (Mono cross-compilation check; outputs discarded)', 'compiler': mcs,
+       'shippedBinariesRebuilt': False, 'reason': 'Milestone 2 changes no C# source; the shipped executables are the Windows-built Milestone 1 binaries (build evidence: evidence/build-evidence.json, GitHub Actions run 45083913369).', 'components': {}}
