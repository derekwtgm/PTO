+  const client = { x: 100, y: 80, w: 960, h: 600 }, px = (b) => ({ x: Math.round(client.x + b.x * client.w), y: Math.round(client.y + b.y * client.h), w: Math.round(b.w * client.w), h: Math.round(b.h * client.h) });
