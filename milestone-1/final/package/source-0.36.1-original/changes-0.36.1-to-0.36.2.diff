diff -ruN '--exclude=START.html' base/EightMax-Test-Workbench/.github/workflows/windows-0362-m1-final.yml m1/tree/.github/workflows/windows-0362-m1-final.yml
--- base/EightMax-Test-Workbench/.github/workflows/windows-0362-m1-final.yml	1970-01-01 00:00:00.000000000 +0000
+++ m1/tree/.github/workflows/windows-0362-m1-final.yml	2026-11-22 23:01:19.363176051 +0000
@@ -0,0 +1,111 @@
+name: EightMax 0.36.2 Milestone 1 - package and re-verify the final ZIP on Windows
+# Takes the candidate tree built and tested by windows-0362-m1.yml (run id in milestone-1/final/BUILD-RUN-ID), adds the final
+# report files, packages EightMax-Test-Workbench-0.36.2-Milestone-1.zip, then extracts THAT ZIP into a fresh folder and reruns
+# the focused Milestone 1 checks with Python and Node removed from PATH (normal operation uses only the bundled runtimes).
+# Nothing is recompiled here: the executables must be byte-identical to the build run's evidence.
+on:
+  push:
+    branches: [milestone-1-0362]
+    paths: ['milestone-1/final/**']
+  workflow_dispatch:
+permissions:
+  contents: write   # only to publish the final ZIP and its verification to its own m1-final/<run id> branch
+  actions: read
+jobs:
+  package-and-verify:
+    runs-on: windows-latest
+    timeout-minutes: 40
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - name: Read build run id
+        shell: pwsh
+        run: |
+          $id = (Get-Content milestone-1/final/BUILD-RUN-ID -Raw).Trim(); if ($id -notmatch '^\d+$') { throw 'bad run id' }
+          "BUILD_RUN_ID=$id" >> $env:GITHUB_ENV; "CANDIDATE_SHA256=$((Get-Content milestone-1/final/CANDIDATE-SHA256 -Raw).Trim())" >> $env:GITHUB_ENV
+      - uses: actions/download-artifact@v4
+        with:
+          name: eightmax-0362-m1-candidate
+          path: ${{ runner.temp }}/candidate
+          run-id: ${{ env.BUILD_RUN_ID }}
+          github-token: ${{ secrets.GITHUB_TOKEN }}
+      - name: Verify candidate, add final report files, package the final ZIP
+        shell: pwsh
+        run: |
+          $L = "$env:RUNNER_TEMP\logs"; New-Item -ItemType Directory -Force $L | Out-Null
+          $zip = "$env:RUNNER_TEMP\candidate\EightMax-0.36.2-M1-candidate.zip"; $h = (Get-FileHash $zip).Hash.ToLowerInvariant()
+          "candidate from run $env:BUILD_RUN_ID sha256 $h (expected $env:CANDIDATE_SHA256)" | Tee-Object "$L\package.log"; if ($h -ne $env:CANDIDATE_SHA256) { throw 'candidate checksum mismatch' }
+          python -I -c "import zipfile,sys; zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])" $zip "$env:RUNNER_TEMP\pkg"
+          $W = "$env:RUNNER_TEMP\pkg\EightMax-Test-Workbench"; . "$W\windows\Common.ps1"; $f = @(Get-WorkbenchHashFailures $W); "candidate manifest failures: $($f.Count)" | Tee-Object -Append "$L\package.log"; if ($f.Count) { throw ($f -join '; ') }
+          $before = @{}; foreach ($e in Get-ChildItem "$W\desktop\bin\*.exe", "$W\native\mwcli.exe", "$W\runtime\node\node.exe") { $before[$e.FullName] = (Get-FileHash $e.FullName).Hash }
+          python -I -c "import shutil,sys; shutil.copytree(sys.argv[1], sys.argv[2], dirs_exist_ok=True)" milestone-1/final/package $W
+          foreach ($k in $before.Keys) { if ((Get-FileHash $k).Hash -ne $before[$k]) { throw "executable changed while packaging: $k" } }
+          Push-Location $W; python -I tools/release-manifest-0362.py | Tee-Object -Append "$L\package.log"; Pop-Location
+          New-Item -ItemType Directory -Force "$env:RUNNER_TEMP\final" | Out-Null
+          python -I "$W\tools\package-0361.py" "$env:RUNNER_TEMP\final\EightMax-Test-Workbench-0.36.2-Milestone-1.zip" | Tee-Object -Append "$L\package.log"
+          $fh = (Get-FileHash "$env:RUNNER_TEMP\final\EightMax-Test-Workbench-0.36.2-Milestone-1.zip").Hash.ToLowerInvariant()
+          "$fh  EightMax-Test-Workbench-0.36.2-Milestone-1.zip" | Out-File -Encoding ascii "$env:RUNNER_TEMP\final\EightMax-Test-Workbench-0.36.2-Milestone-1.zip.sha256"
+      - name: Set the runner desktop to 1920x1080 (test environment only; matches the earlier 0.35 Windows CI)
+        shell: powershell
+        run: |
+          Add-Type -TypeDefinition @"
+          using System; using System.Runtime.InteropServices;
+          public static class EmDisplay {
+            [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Ansi)] public struct DEVMODE {
+              [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 32)] public string dmDeviceName; public short dmSpecVersion, dmDriverVersion, dmSize, dmDriverExtra;
+              public int dmFields, dmPositionX, dmPositionY, dmDisplayOrientation, dmDisplayFixedOutput; public short dmColor, dmDuplex, dmYResolution, dmTTOption, dmCollate;
+              [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 32)] public string dmFormName; public short dmLogPixels;
+              public int dmBitsPerPel, dmPelsWidth, dmPelsHeight, dmDisplayFlags, dmDisplayFrequency, dmICMMethod, dmICMIntent, dmMediaType, dmDitherType, dmReserved1, dmReserved2, dmPanningWidth, dmPanningHeight; }
+            [DllImport("user32.dll")] static extern bool EnumDisplaySettings(string d, int m, ref DEVMODE dm);
+            [DllImport("user32.dll")] static extern int ChangeDisplaySettings(ref DEVMODE dm, int f);
+            public static int Set(int w, int h) { DEVMODE dm = new DEVMODE(); dm.dmSize = (short)Marshal.SizeOf(typeof(DEVMODE)); EnumDisplaySettings(null, -1, ref dm); dm.dmPelsWidth = w; dm.dmPelsHeight = h; dm.dmFields = 0x80000 | 0x100000; return ChangeDisplaySettings(ref dm, 0); }
+          }
+          "@
+          $r = [EmDisplay]::Set(1920, 1080); Start-Sleep -Seconds 2; Add-Type -AssemblyName System.Windows.Forms
+          "ChangeDisplaySettings returned $r; virtual screen now $([System.Windows.Forms.SystemInformation]::VirtualScreen)" | Tee-Object "$env:RUNNER_TEMP\logs\display.log"
+      - name: Extract the final ZIP into a fresh folder and rerun the focused checks (no Python/Node on PATH)
+        shell: pwsh
+        run: |
+          $dest = 'C:\EightMax-M1-final-check'; if (Test-Path $dest) { Remove-Item -Recurse -Force $dest }
+          Expand-Archive "$env:RUNNER_TEMP\final\EightMax-Test-Workbench-0.36.2-Milestone-1.zip" -DestinationPath $dest
+          $W = "$dest\EightMax-Test-Workbench"
+          $env:PATH = "$env:SystemRoot\System32;$env:SystemRoot;$env:SystemRoot\System32\Wbem;$env:SystemRoot\System32\WindowsPowerShell\v1.0"
+          $env:NODE_PATH = $null; $env:PYTHONHOME = $null
+          $tools = @('python','python3','node','npm','dotnet','csc') | ForEach-Object { $c = Get-Command $_ -ErrorAction SilentlyContinue; "$_ -> $(if ($c) { $c.Source } else { 'not on PATH' })" }
+          $tools | Tee-Object "$env:RUNNER_TEMP\logs\final-path.log"
+          & "$env:SystemRoot\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -ExecutionPolicy Bypass -File "$W\windows\Test-Milestone1-0362.ps1" -OutDir "$env:RUNNER_TEMP\final-check" -WithInputSelfTest 2>&1 | Tee-Object -FilePath "$env:RUNNER_TEMP\logs\final-milestone1-test.log"
+          $code = $LASTEXITCODE
+          & "$W\runtime\node\node.exe" "$W\tools\input-acceptance-035.cjs" --out "$env:RUNNER_TEMP\final-check\input-acceptance.json" --oracle-dir "$env:RUNNER_TEMP\final-oracle" *> "$env:RUNNER_TEMP\logs\final-input-acceptance.log"
+          $acc = $LASTEXITCODE; Get-Content "$env:RUNNER_TEMP\logs\final-input-acceptance.log" | Select-Object -Last 5
+          if ($code -ne 0) { throw "final-ZIP Milestone 1 checks failed (exit $code)" }; if ($acc -ne 0) { throw "final-ZIP input acceptance failed (exit $acc)" }
+      - name: Publish the final ZIP and its verification to the m1-final/<run id> branch
+        if: always()
+        shell: pwsh
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          $R = "$env:RUNNER_TEMP\publish"; New-Item -ItemType Directory -Force "$R\logs", "$R\final-check" | Out-Null
+          Copy-Item "$env:RUNNER_TEMP\final\*" $R -Force -ErrorAction SilentlyContinue; Copy-Item "$env:RUNNER_TEMP\logs\*" "$R\logs" -Force -ErrorAction SilentlyContinue
+          if (Test-Path "$env:RUNNER_TEMP\final-check") { Get-ChildItem "$env:RUNNER_TEMP\final-check" -File | Where-Object { $_.Name -notlike '*-session.json' } | Copy-Item -Destination "$R\final-check" -Force }
+          Set-Location $R; "* -text" | Out-File -Encoding ascii .gitattributes
+          git init -q; git config user.name "github-actions"; git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git add -A; git commit -q -m "Milestone 1 final ZIP and re-verification from run $env:GITHUB_RUN_ID"
+          git push -q "https://x-access-token:$env:GH_TOKEN@github.com/$env:GITHUB_REPOSITORY.git" "HEAD:refs/heads/m1-final/$env:GITHUB_RUN_ID"
+          foreach ($x in Get-ChildItem "$R\logs" -File) { "===== $($x.Name)"; Get-Content $x.FullName -Tail 200 }
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: EightMax-Test-Workbench-0.36.2-Milestone-1
+          path: |
+            ${{ runner.temp }}/final
+          compression-level: 0
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: eightmax-0362-m1-final-verification
+          path: |
+            ${{ runner.temp }}/logs
+            ${{ runner.temp }}/final-check
+            !${{ runner.temp }}/final-check/*-session.json
diff -ruN '--exclude=START.html' base/EightMax-Test-Workbench/.github/workflows/windows-0362-m1.yml m1/tree/.github/workflows/windows-0362-m1.yml
--- base/EightMax-Test-Workbench/.github/workflows/windows-0362-m1.yml	1970-01-01 00:00:00.000000000 +0000
+++ m1/tree/.github/workflows/windows-0362-m1.yml	2026-11-22 23:01:19.367058926 +0000
@@ -0,0 +1,179 @@
+name: EightMax 0.36.2 Milestone 1 - Windows build and focused verification
+# Builds the Windows executables from the verified 0.36.1 source ZIP plus the small milestone-1 overlay (version 0.36.2.0),
+# then runs the focused Milestone 1 checks on a real Windows desktop. Interactive gameplay, strategy and multi-table capacity
+# are out of scope. Bundled runtimes (runtime\node\node.exe) run every Node step; Python and npm are developer build tools only.
+on:
+  push:
+    branches: [milestone-1-0362]
+    paths: ['milestone-1/overlay/**', '.github/workflows/windows-0362-m1.yml']
+  workflow_dispatch:
+permissions:
+  contents: write   # only to publish this run's evidence to its own m1-results/<run id> branch
+jobs:
+  build-and-verify:
+    runs-on: windows-latest
+    timeout-minutes: 80
+    env:
+      BASE_ZIP: EightMax-Test-Workbench-0.36.1-Complete-Simulator.zip
+      BASE_SHA256: 2586ebf67103937bd6fadbfc2aa4d32a5787cf02693a8fb215876d4ea038e487
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22.23.5'
+      - name: Verify and extract the 0.36.1 baseline
+        shell: pwsh
+        run: |
+          $L = "$env:RUNNER_TEMP\logs"; New-Item -ItemType Directory -Force $L | Out-Null
+          $h = (Get-FileHash $env:BASE_ZIP -Algorithm SHA256).Hash.ToLowerInvariant()
+          "baseline ZIP $env:BASE_ZIP sha256 $h (expected $env:BASE_SHA256)" | Tee-Object "$L\baseline.log"
+          if ($h -ne $env:BASE_SHA256) { throw 'Baseline ZIP checksum mismatch' }
+          python -I -c "import zipfile,sys; z=zipfile.ZipFile(sys.argv[1]); bad=z.testzip(); print('zip entries', len(z.namelist()), 'crc', 'ok' if bad is None else bad); sys.exit(bad is not None); " $env:BASE_ZIP | Tee-Object -Append "$L\baseline.log"
+          if ($LASTEXITCODE) { throw 'Baseline ZIP CRC failed' }
+          python -I -c "import zipfile,sys; zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])" $env:BASE_ZIP work
+          $W = (Resolve-Path work\EightMax-Test-Workbench).Path; "W=$W" >> $env:GITHUB_ENV
+          . "$W\windows\Common.ps1"; $f = @(Get-WorkbenchHashFailures $W)
+          "baseline manifest: $((Get-Content "$W\SHA256SUMS.txt").Count) entries, $($f.Count) failures $($f -join '; ')" | Tee-Object -Append "$L\baseline.log"
+          if ($f.Count) { throw 'Baseline manifest failed' }
+          foreach ($e in 'EightMaxWorkbench.exe','EightMaxInput.exe','EightMaxTestTable.exe','EightMaxCapture.exe','EightMaxWgc.exe') { $p = "$W\desktop\bin\$e"; $v = (Get-Item $p).VersionInfo; "baseline $e FileVersion=$($v.FileVersion) ProductVersion=$($v.ProductVersion) sha256=$((Get-FileHash $p).Hash.ToLowerInvariant())" | Tee-Object -Append "$L\baseline.log" }
+          "baseline native\mwcli.exe sha256=$((Get-FileHash "$W\native\mwcli.exe").Hash.ToLowerInvariant()) $(& "$W\native\mwcli.exe" --build-id)" | Tee-Object -Append "$L\baseline.log"
+      - name: Apply the Milestone 1 overlay
+        shell: pwsh
+        run: |
+          python -I -c "import shutil,sys; shutil.copytree(sys.argv[1], sys.argv[2], dirs_exist_ok=True)" milestone-1/overlay $env:W
+          $bad = @(); Get-ChildItem -Recurse -File -Force milestone-1/overlay | ForEach-Object { $rel = $_.FullName.Substring((Resolve-Path milestone-1/overlay).Path.Length + 1); $a = (Get-FileHash $_.FullName).Hash; $b = (Get-FileHash (Join-Path $env:W $rel)).Hash; "$a  $rel" | Tee-Object -Append "$env:RUNNER_TEMP\logs\overlay.log"; if ($a -ne $b) { $bad += $rel } }
+          if ($bad.Count) { throw ('Overlay copy mismatch: ' + ($bad -join ', ')) }
+      - name: Parse every Windows PowerShell script
+        shell: powershell
+        run: |
+          $errs = @(); foreach ($f in Get-ChildItem "$env:W\windows","$env:W\native" -Filter *.ps1) { $t = $null; $e = $null; [void][System.Management.Automation.Language.Parser]::ParseFile($f.FullName, [ref]$t, [ref]$e); foreach ($x in $e) { $errs += ($f.Name + ':' + $x.Extent.StartLineNumber + ': ' + $x.Message) } }
+          $errs | Out-File "$env:RUNNER_TEMP\logs\powershell-parse.log"; "parsed; $($errs.Count) errors"
+          if ($errs.Count) { $errs; throw 'PowerShell parse errors' }
+      - name: Compile Windows executables (.NET Framework csc, x64)
+        shell: powershell
+        run: |
+          Set-Location $env:W
+          powershell -NoProfile -ExecutionPolicy Bypass -File windows\Build-Executables.ps1 -SkipWgc *> "$env:RUNNER_TEMP\logs\build-executables.log"
+          $code = $LASTEXITCODE; Get-Content "$env:RUNNER_TEMP\logs\build-executables.log"
+          if ($code -ne 0) { throw "Build-Executables.ps1 failed with exit code $code" }
+      - name: Generate dashboard, component status and manifest
+        shell: pwsh
+        run: |
+          Set-Location $env:W
+          & { python -I tools/build.py; python -I tools/make-components.py; python -I tools/release-manifest-0362.py } *>&1 | Tee-Object "$env:RUNNER_TEMP\logs\generate.log"
+          if ($LASTEXITCODE) { throw 'generation failed' }
+      - name: Set the runner desktop to 1920x1080 (test environment only; matches the earlier 0.35 Windows CI)
+        shell: powershell
+        run: |
+          Add-Type -TypeDefinition @"
+          using System; using System.Runtime.InteropServices;
+          public static class EmDisplay {
+            [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Ansi)] public struct DEVMODE {
+              [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 32)] public string dmDeviceName; public short dmSpecVersion, dmDriverVersion, dmSize, dmDriverExtra;
+              public int dmFields, dmPositionX, dmPositionY, dmDisplayOrientation, dmDisplayFixedOutput; public short dmColor, dmDuplex, dmYResolution, dmTTOption, dmCollate;
+              [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 32)] public string dmFormName; public short dmLogPixels;
+              public int dmBitsPerPel, dmPelsWidth, dmPelsHeight, dmDisplayFlags, dmDisplayFrequency, dmICMMethod, dmICMIntent, dmMediaType, dmDitherType, dmReserved1, dmReserved2, dmPanningWidth, dmPanningHeight; }
+            [DllImport("user32.dll")] static extern bool EnumDisplaySettings(string d, int m, ref DEVMODE dm);
+            [DllImport("user32.dll")] static extern int ChangeDisplaySettings(ref DEVMODE dm, int f);
+            public static int Set(int w, int h) { DEVMODE dm = new DEVMODE(); dm.dmSize = (short)Marshal.SizeOf(typeof(DEVMODE)); EnumDisplaySettings(null, -1, ref dm); dm.dmPelsWidth = w; dm.dmPelsHeight = h; dm.dmFields = 0x80000 | 0x100000; return ChangeDisplaySettings(ref dm, 0); }
+          }
+          "@
+          $r = [EmDisplay]::Set(1920, 1080); Start-Sleep -Seconds 2; Add-Type -AssemblyName System.Windows.Forms
+          "ChangeDisplaySettings returned $r; virtual screen now $([System.Windows.Forms.SystemInformation]::VirtualScreen)" | Tee-Object "$env:RUNNER_TEMP\logs\display.log"
+      - name: Milestone 1 focused Windows checks
+        id: m1
+        timeout-minutes: 15
+        shell: pwsh
+        run: |
+          Set-Location $env:W
+          powershell -NoProfile -ExecutionPolicy Bypass -File windows\Test-Milestone1-0362.ps1 -OutDir "$env:RUNNER_TEMP\m1" -WithInputSelfTest 2>&1 | Tee-Object -FilePath "$env:RUNNER_TEMP\logs\milestone1-test.log"
+          $code = $LASTEXITCODE; "exit=$code" | Out-File "$env:RUNNER_TEMP\m1\exit-code.txt"
+          if ($code -ne 0) { throw "Milestone 1 checks failed (exit $code)" }
+      - name: Compatibility smoke - input acceptance on the controlled test tables
+        if: success() || failure()
+        timeout-minutes: 8
+        shell: pwsh
+        run: |
+          Set-Location $env:W
+          & .\runtime\node\node.exe tools\input-acceptance-035.cjs --out "$env:RUNNER_TEMP\m1\input-acceptance.json" --oracle-dir "$env:RUNNER_TEMP\input-oracle" 2>&1 | Tee-Object -FilePath "$env:RUNNER_TEMP\logs\input-acceptance.log"
+          $code = $LASTEXITCODE; if ($code -ne 0) { throw "input acceptance exit $code" }
+      - name: Communication smoke - host capture and input broker against one test table
+        if: success() || failure()
+        timeout-minutes: 6
+        shell: pwsh
+        run: |
+          Set-Location $env:W
+          & .\runtime\node\node.exe tools\simulator-benchmark-035.cjs --tables 1 --seconds 45 --workloads stress:2500 --width 960 --out "$env:RUNNER_TEMP\m1\benchmark-smoke.json" --work "$env:RUNNER_TEMP\benchmark-work" 2>&1 | Tee-Object -FilePath "$env:RUNNER_TEMP\logs\benchmark-smoke.log"
+          $code = $LASTEXITCODE; if ($code -ne 0) { throw "benchmark smoke exit $code" }
+      - name: Existing regression suite with the bundled Node runtime
+        if: success() || failure()
+        timeout-minutes: 25
+        shell: pwsh
+        run: |
+          New-Item -ItemType Directory -Force "$env:RUNNER_TEMP\em-browser" | Out-Null; Push-Location "$env:RUNNER_TEMP\em-browser"
+          npm install --no-audit --no-fund playwright *> "$env:RUNNER_TEMP\logs\playwright-install.log"; npx playwright install chromium *>> "$env:RUNNER_TEMP\logs\playwright-install.log"
+          $env:NODE_PATH = "$env:RUNNER_TEMP\em-browser\node_modules"; $env:CHROME_PATH = (node -e "console.log(require('playwright').chromium.executablePath())"); Pop-Location
+          Set-Location $env:W; $env:EIGHTMAX_TEST_CLI = (Resolve-Path native\mwcli.exe).Path
+          & .\runtime\node\node.exe --test tests/*.test.cjs *> "$env:RUNNER_TEMP\logs\regression.log"
+          $code = $LASTEXITCODE; Get-Content "$env:RUNNER_TEMP\logs\regression.log" | Select-String -Pattern '^# (tests|pass|fail|cancelled|skipped|duration)|^not ok' ; if ($code -ne 0) { throw "regression exit $code" }
+      - name: Record this run, regenerate component status, recheck release metadata
+        if: always()
+        shell: pwsh
+        run: |
+          Set-Location $env:W
+          if (-not (Test-Path "$env:RUNNER_TEMP\m1\milestone1-results.json")) { 'no milestone-1 results; nothing recorded'; exit 0 }
+          python -I tools/record-windows-run-0362.py --m1 "$env:RUNNER_TEMP\m1\milestone1-results.json" --selftest "$env:RUNNER_TEMP\m1\input-selftest.json" --acceptance "$env:RUNNER_TEMP\m1\input-acceptance.json" --benchmark "$env:RUNNER_TEMP\m1\benchmark-smoke.json" --regression "$env:RUNNER_TEMP\logs\regression.log" --candidate "0.36.1 ZIP $env:BASE_SHA256 + milestone-1 overlay at $env:GITHUB_SHA" *>&1 | Tee-Object "$env:RUNNER_TEMP\logs\record-run.log"
+          python -I tools/release-manifest-0362.py
+          & .\runtime\node\node.exe --test tests/release-031.test.cjs tests/release-032.test.cjs tests/release-033.test.cjs tests/release-035.test.cjs tests/release-consistency.test.cjs tests/wgc-027.test.cjs tests/wgc-028.test.cjs tests/windows-025.test.cjs *> "$env:RUNNER_TEMP\logs\metadata-recheck.log"
+          Get-Content "$env:RUNNER_TEMP\logs\metadata-recheck.log" | Select-String -Pattern '^# (tests|pass|fail)|^not ok'
+      - name: Package the candidate tree with its evidence
+        if: always()
+        shell: pwsh
+        run: |
+          Set-Location $env:W
+          $E = "$env:W\evidence\0.36.2\windows"; New-Item -ItemType Directory -Force $E | Out-Null
+          Copy-Item "$env:RUNNER_TEMP\logs\*" $E -Force
+          if (Test-Path "$env:RUNNER_TEMP\m1") { Copy-Item "$env:RUNNER_TEMP\m1\*" $E -Force -Exclude '*-session.json' }
+          Get-ChildItem $E | Format-Table Name, Length -AutoSize | Out-String | Write-Host
+          python -I tools/release-manifest-0362.py
+          . .\windows\Common.ps1; $f = @(Get-WorkbenchHashFailures $env:W); "final manifest failures: $($f.Count)"; if ($f.Count) { throw ($f -join '; ') }
+          python -I tools/package-0361.py "$env:RUNNER_TEMP\EightMax-0.36.2-M1-candidate.zip"
+      - name: Publish evidence to the m1-results/<run id> branch (artifacts are not reachable from the dev session)
+        if: always()
+        shell: pwsh
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          $R = "$env:RUNNER_TEMP\results"; New-Item -ItemType Directory -Force "$R\logs", "$R\m1" | Out-Null
+          Copy-Item "$env:RUNNER_TEMP\logs\*" "$R\logs" -Force -ErrorAction SilentlyContinue
+          if (Test-Path "$env:RUNNER_TEMP\m1") { Get-ChildItem "$env:RUNNER_TEMP\m1" -File | Where-Object { $_.Name -notlike '*-session.json' } | Copy-Item -Destination "$R\m1" -Force }
+          $z = "$env:RUNNER_TEMP\EightMax-0.36.2-M1-candidate.zip"; if (Test-Path $z) { Copy-Item $z $R; "$((Get-FileHash $z).Hash.ToLowerInvariant())  EightMax-0.36.2-M1-candidate.zip" | Out-File -Encoding ascii "$R\EightMax-0.36.2-M1-candidate.zip.sha256" }
+          Get-ChildItem -Recurse $R -File | ForEach-Object { "$($_.Length)`t$($_.FullName.Substring($R.Length + 1))" }
+          Set-Location $R; "* -text" | Out-File -Encoding ascii .gitattributes
