+    $checks.Add([ordered]@{ group = $Group; name = $Name; status = $(if ($Passed) { 'pass' } elseif ($Required) { 'fail' } else { 'warn' }); required = $Required; detail = $Detail; at = [DateTime]::UtcNow.ToString('o') })
