 "inputStatus": [
  {
   "status": "confirmed",
   "meaning": "the next state shows exactly this action",
   "handling": "play continues"
  },
  {
   "status": "rejected-before-input",
   "meaning": "refused before any button or key went down (deadline, lease revoked, lifecycle guard, layout changed, ...)",
   "handling": "nothing was sent: a NEW decision from a fresh reading may follow (bounded: 4 in a row pause the table)"
  },
  {
   "status": "rejected-no-change",
   "meaning": "delivered by the driver; the screen did not change within the confirmation window and a fresh reading shows the same decision point",
   "handling": "SAFETY_PAUSED (input-rejected), never repeated, evidence recorded, operator Resume -> RECOVERY_PENDING -> fresh readings"
  },
  {
   "status": "uncertain",
   "meaning": "may have been applied (window lost after the input, stop / emergency stop / manual override during it)",
   "handling": "SAFETY_PAUSED or TARGET_LOST, never repeated, review required, evidence recorded"
  },
  {
   "status": "timed-out",
   "meaning": "no reliable reading within the confirmation window",
   "handling": "SAFETY_PAUSED (unconfirmed-input), never repeated, evidence recorded"
  },
  {
   "status": "ambiguous",
   "meaning": "the table changed, but not as one application of this action",
   "handling": "SAFETY_PAUSED (unconfirmed-input), never repeated, evidence recorded"
  },
  {
   "status": "cancelled-after-input / cancelled-before-input",
   "meaning": "cancelled during / before the operation",
   "handling": "after input: as uncertain; before input: nothing was sent"
  }
 ],
